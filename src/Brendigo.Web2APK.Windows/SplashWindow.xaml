<Window x:Class="Brendigo.Web2APK.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brendigo Web2APK Builder" Width="790" Height="490"
        AllowsTransparency="True" WindowStyle="None"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Border x:Name="SplashRoot" CornerRadius="20" BorderThickness="1" BorderBrush="#534796">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#08234B" Offset="0"/>
                <GradientStop Color="#101634" Offset=".48"/>
                <GradientStop Color="#29174C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
                <Border Width="95" Height="95" Background="#7253EF" CornerRadius="23"
                        HorizontalAlignment="Center" Margin="0,0,0,27">
                    <Image Source="Assets/Brendigo.ico" Width="72" Height="72" Stretch="Uniform"/>
                </Border>
                <TextBlock Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="29" FontWeight="Bold"
                           HorizontalAlignment="Center" Text="Brendigo Web2APK"/>
                <TextBlock Foreground="#B9AEFF" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,7,0,20" Text="BUILDER STUDIO"/>
                <TextBlock Foreground="#C4CEE8" FontFamily="Segoe UI" FontSize="13"
                           HorizontalAlignment="Center" Text="Web-stranice pretvorite u Android aplikacije."/>
                <ProgressBar IsIndeterminate="True" Foreground="#8071FF" Background="#1A2B4D"
                             Width="285" Height="6" BorderThickness="0" Margin="0,38,0,13"/>
                <TextBlock Foreground="#91A3C6" FontSize="11" Text="Pokretanje aplikacije…"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="© Brendigo · brendigo.com" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,25"
                       Foreground="#8297C6" FontFamily="Segoe UI" FontSize="11"/>
        </Grid>
    </Border>
</Window>
