<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Brendigo.Web2APK</AssemblyName>
    <RootNamespace>Brendigo.Web2APK.Windows</RootNamespace>
    <Version>0.3.1</Version>
    <FileVersion>0.3.1.0</FileVersion>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets/Brendigo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Brendigo.Web2APK.Core/Brendigo.Web2APK.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Brendigo.ico" /></ItemGroup>
</Project>
