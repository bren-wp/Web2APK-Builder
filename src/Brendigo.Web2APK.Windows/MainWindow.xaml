<Window x:Class="Brendigo.Web2APK.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brendigo Web2APK Builder — Windows Studio"
        Icon="Assets/Brendigo.ico"
        Width="1340" Height="830" MinWidth="840" MinHeight="570" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0A1228"
                BorderBrush="#253251" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_Drag">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Minimiziraj prozor"
                        Width="43" Height="33" BorderThickness="0" Background="Transparent"
                        Foreground="#CBD4EC" Click="TitleBar_Minimize"/>
                    <Button x:Name="WindowMaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Povećaj prozor"
                        Width="43" Height="33" BorderThickness="0" Background="Transparent"
                        Foreground="#CBD4EC" Click="TitleBar_Maximize"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Zatvori aplikaciju"
                        Width="43" Height="33" BorderThickness="0" Background="Transparent"
                        Foreground="#E3C3CD" Click="TitleBar_Close"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0">
                    <Image Source="Assets/Brendigo.ico" Width="21" Height="21" Margin="0,0,10,0"/>
                    <TextBlock Text="Brendigo Web2APK Builder" FontSize="12"
                        Foreground="#AABBD9" VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <Border Background="#28224B" CornerRadius="8" Padding="6,3">
                        <TextBlock Text="STUDIO" FontSize="9" Foreground="#BDAFFF"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#263450" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,26,16,18">
                <Border x:Name="SidebarFooter" DockPanel.Dock="Bottom" CornerRadius="14" Background="#16223E" BorderBrush="#2A3C60"
                        BorderThickness="1" Padding="11,13" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Foreground="#76E7CD" FontSize="11" FontWeight="Bold" Text="●  Lokalni radni prostor"/>
                        <TextBlock Text="Brendigo Web2APK Builder" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        
                        <TextBlock Text="apk.com.hr" Foreground="#94A9D6" FontSize="11"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="SidebarBrandArea" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,3,0,27">
                    <Border x:Name="SidebarLogoTile" Width="47" Height="47" CornerRadius="13" Background="#7451ED">
                        <Image Source="Assets/Brendigo.ico" Width="36" Height="36" Stretch="Uniform"/>
                    </Border>
                    <StackPanel x:Name="BrandWords" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Brendigo" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Web2APK" Foreground="#B5A0FF" FontSize="15" FontWeight="Bold" Margin="0,-3,0,0"/>
                        <TextBlock Text="BUILDER" FontWeight="SemiBold" Foreground="#98A8D1" FontSize="9" Margin="0,-3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationHost"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#11264B" Offset="0"/>
                    <GradientStop Color="#0A1126" Offset=".55"/>
                    <GradientStop Color="#191B43" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#10182F" BorderBrush="#263350" BorderThickness="0,0,0,1">
                <Grid x:Name="HeaderContent" Margin="32,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Breadcrumb" Grid.Column="0" VerticalAlignment="Center" Foreground="#A3B5DB" Text="Radni prostor   ›   Početna" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SdkStatusBadge" Background="#242943" BorderBrush="#515C83" BorderThickness="1" CornerRadius="14" Padding="10,5">
                            <TextBlock x:Name="AndroidSdkState" Foreground="#B7BFDB" Text="Android SDK · provjera" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Margin="15,0,0,0" Background="#6254D5" CornerRadius="18" Width="34" Height="34">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Text="BR" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageHost" Margin="32,9,32,42"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
