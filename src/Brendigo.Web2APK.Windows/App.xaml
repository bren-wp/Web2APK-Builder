<Application x:Class="Brendigo.Web2APK.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0A1025"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151E38"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0A1227"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3B3D4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F4FF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#293859"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7853F5"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button" x:Key="StudioButton">
            <Setter Property="Background" Value="#1D2A4B"/>
            <Setter Property="Foreground" Value="#E4EAFF"/>
            <Setter Property="BorderBrush" Value="#39496F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".68"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#BDAFFF"/>
                                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value=".38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="NavigationButton" BasedOn="{StaticResource StudioButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1832"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="CaretBrush" Value="#B4A0FF"/>
            <Setter Property="BorderBrush" Value="#34466C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A local dark control template prevents native white ComboBox popups and fields. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0D1832"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="CaretBrush" Value="#B4A0FF"/>
            <Setter Property="BorderBrush" Value="#34466C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="43"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#132242"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="BorderBrush" Value="#405383"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#132242"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#192744"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="BorderBrush" Value="#42537B"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#111D37"/>
            <Setter Property="Foreground" Value="#EDF2FF"/>
            <Setter Property="BorderBrush" Value="#38496C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EDF2FF"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Selection" Padding="{TemplateBinding Padding}"
                            CornerRadius="6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="#3C327D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="#253458"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEF2FF"/>
            <Setter Property="Background" Value="#0F1A36"/>
            <Setter Property="BorderBrush" Value="#33466E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="SelectionBorder" CornerRadius="9"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Margin="13,2,35,2"/>
                                    <TextBlock Text="⌄" Foreground="#AFA5F3" FontSize="19"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,12,3"/>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Opacity="0.01"
                                Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup"
                                PlacementTarget="{Binding ElementName=SelectionBorder}"
                                Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                StaysOpen="False" PopupAnimation="Fade"
                                IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#132242" BorderBrush="#405383"
                                    BorderThickness="1" CornerRadius="9"
                                    MinWidth="{Binding ActualWidth,ElementName=SelectionBorder}"
                                    MaxHeight="300">
                                    <ScrollViewer CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#826DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectionBorder" Property="Opacity" Value=".52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF2FF"/>
            <Setter Property="Background" Value="#142345"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#352C78"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#4D3C9F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionBorder" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckFrame" Width="20" Height="20"
                                CornerRadius="6" BorderThickness="1" BorderBrush="#50618A"
                                Background="#121F3F" VerticalAlignment="Top" Margin="0,2,12,0">
                                <TextBlock x:Name="CheckMark" Text="✓" FontSize="13" FontWeight="Bold"
                                    Foreground="White" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="Content"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckFrame" Property="Background" Value="#7554F6"/>
                                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#A59AFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
