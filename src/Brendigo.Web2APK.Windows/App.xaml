<Application x:Class="Brendigo.Web2APK.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0A1025"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151E38"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0A1227"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3B3D4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F4FF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#293859"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7853F5"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button" x:Key="StudioButton">
            <Setter Property="Background" Value="#1D2A4B"/>
            <Setter Property="Foreground" Value="#E4EAFF"/>
            <Setter Property="BorderBrush" Value="#39496F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".68"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value=".38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="NavigationButton" BasedOn="{StaticResource StudioButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1832"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="CaretBrush" Value="#B4A0FF"/>
            <Setter Property="BorderBrush" Value="#34466C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F4FF"/>
            <Setter Property="Background" Value="#142344"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEF3FF"/>
            <Setter Property="Background" Value="#172444"/>
            <Setter Property="Padding" Value="11,9"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A317F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5545AB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
    </Application.Resources>
</Application>
