<Application x:Class="Brendigo.Web2APK.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#090F21"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151F3A"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C142A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3B3D4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F4FF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#2A3A5D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7852FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button" x:Key="StudioButton">
            <Setter Property="Background" Value="#1D2A4B"/>
            <Setter Property="Foreground" Value="#E4EAFF"/>
            <Setter Property="BorderBrush" Value="#39496F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value=".68"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value=".38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="NavigationButton" BasedOn="{StaticResource StudioButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1832"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="CaretBrush" Value="#B4A0FF"/>
            <Setter Property="BorderBrush" Value="#34466C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#121B35"/>
            <Setter Property="Background" Value="#E5E9FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
    </Application.Resources>
</Application>
