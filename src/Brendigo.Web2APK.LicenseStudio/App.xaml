<Application x:Class="Brendigo.Web2APK.LicenseStudio.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  StartupUri="MainWindow.xaml"><Application.Resources>
  <SolidColorBrush x:Key="Text" Color="#EDF2FF"/>
  <SolidColorBrush x:Key="Muted" Color="#A7B8D8"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1934"/>
    <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="CaretBrush" Value="#AE99FF"/>
    <Setter Property="BorderBrush" Value="#334B76"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="13,11"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="44"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D1934"/>
    <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="CaretBrush" Value="#AE99FF"/>
    <Setter Property="BorderBrush" Value="#334B76"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="13,11"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="44"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EDF2FF"/>
    <Setter Property="Background" Value="#24365F"/><Setter Property="BorderBrush" Value="#435687"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="Opacity" Value=".85"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".35"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</Application.Resources></Application>
