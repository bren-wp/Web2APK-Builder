<Window x:Class="Brendigo.Web2APK.LicenseStudio.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Brendigo License Studio" Icon="Assets/Brendigo.ico"
  Width="990" Height="700" MinWidth="760" MinHeight="605"
  WindowStartupLocation="CenterScreen" WindowState="Normal" ResizeMode="CanResizeWithGrip"
  Background="#0A1025" UseLayoutRounding="True">
  <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#09142B" Offset="0"/><GradientStop Color="#17173E" Offset="1"/>
    </LinearGradientBrush></Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#121B36" BorderBrush="#303D68" BorderThickness="0,0,0,1" Padding="24,19">
      <DockPanel>
        <Image Source="Assets/Brendigo.ico" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,16,0"/>
        <StackPanel><TextBlock Text="BRENDIGO LICENSE STUDIO" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="Sigurno izdavanje licenci · Windows" Foreground="#B3BEE1" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,22,24,20">
        <Border Background="#16203D" BorderBrush="#364978" BorderThickness="1" CornerRadius="16" Padding="23">
          <StackPanel>
            <TextBlock Text="1 · Vlasnički ključ" FontWeight="Bold" FontSize="17" Margin="0,0,0,8"/>
            <TextBlock Text="Privatni ključ mora ostati samo na vašem računalu. Nikada ga ne uključujte u instalaciju ili GitHub."
              Foreground="#B0C3E2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="KeyPath" IsReadOnly="True" ToolTip="Šifrirani vlasnički PEM"/>
              <Button Grid.Column="1" Click="BrowseKey_Click" Content="Odaberi ključ…" Margin="12,0,0,0"/>
            </Grid>
            <TextBlock Text="Lozinka vlasničkog ključa" FontSize="12" Foreground="#B9CBEB" Margin="0,14,0,7"/>
            <PasswordBox x:Name="OwnerPassword"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#16203D" BorderBrush="#364978" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="2 · Količina licenci" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
              <TextBox x:Name="CountBox" Text="1000"/>
              <TextBlock Text="Unesite bilo koji pozitivan cijeli broj. Izvoz je protočan i ne čuva cijeli popis u RAM-u."
                Foreground="#A9B9D9" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#16203D" BorderBrush="#364978" BorderThickness="1"
                  CornerRadius="16" Padding="22" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="3 · Trajanje" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
              <TextBlock Text="Doživotno" FontSize="17" FontWeight="SemiBold" Foreground="#83E0C4"/>
              <TextBlock Text="Sve licence vrijede trajno za pripadajući paket i, osim Developera, jednu aplikaciju."
                Foreground="#A9B9D9" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="#16203D" BorderBrush="#364978" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="4 · Namjena licenci" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BothButton" Content="Windows + Android" Click="Both_Click" Background="#664CE2" Margin="0,0,10,0"/>
              <Button x:Name="WindowsButton" Content="Samo Windows" Click="Windows_Click" Margin="0,0,10,0"/>
              <Button x:Name="AndroidButton" Content="Samo Android" Click="Android_Click"/>
            </StackPanel>
            <TextBlock Text="Licence s oba prava rade u obje aplikacije. Licenca ne otkriva privatni potpisni ključ."
              Foreground="#A9B9D9" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="#16203D" BorderBrush="#364978" BorderThickness="1" CornerRadius="16"
                Padding="22" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="5 · Odaberite paket licence" FontSize="17" FontWeight="Bold" Margin="0,0,0,13"/>
            <WrapPanel>
              <Button x:Name="DemoButton" Content="Demo · 0 €" Click="Demo_Click" Background="#6650D6" Margin="0,0,8,8"/>
              <Button x:Name="BasicButton" Content="Osnovno · 49 €" Click="Basic_Click" Margin="0,0,8,8"/>
              <Button x:Name="ProButton" Content="Profesionalac · 69 €" Click="Pro_Click" Margin="0,0,8,8"/>
              <Button x:Name="AgencyButton" Content="Agencija · 39 €/mj." Click="Agency_Click" Margin="0,0,8,8"/>
              <Button x:Name="DeveloperButton" Content="Developer · vlasnik" Click="Developer_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock x:Name="TierDetails" Text="Demo: APK bez oglasa, jedna aplikacija, trajno."
                       Foreground="#A9B9D9" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Android package ID (jedna aplikacija; Developer nema ograničenje)" FontSize="12"
                       Foreground="#C0CCEA" Margin="0,14,0,7"/>
            <TextBox x:Name="PackageBox" Text="com.brendigo.mojaaplikacija"/>
            <TextBlock x:Name="ScopeHint" Foreground="#A9B9D9" FontSize="11"
              Text="Profesionalac: do 3 package ID-ja odvojena zarezom." TextWrapping="Wrap"
              Margin="0,8,0,0"/>
            <TextBlock Foreground="#C0CCEA" FontSize="12" Text="Agencijsko razdoblje"
              Margin="0,14,0,7"/>
            <ComboBox x:Name="AgencyDuration" SelectedIndex="0" IsEnabled="False"
              Background="#16274C" Foreground="#EFF2FF" BorderBrush="#435889">
              <ComboBoxItem Content="1 mjesec · 39 €"/>
              <ComboBoxItem Content="12 mjeseci · 390 €"/>
            </ComboBox>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Text="Spremno za izdavanje licenci." Foreground="#A9BDDF"
          FontSize="12" Margin="3,17,0,9"/>
        <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Value="0"
          Background="#192B50" Foreground="#8066FF" BorderThickness="0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#111A33" BorderBrush="#303D68" BorderThickness="0,1,0,0" Padding="24,16">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Brendigo · apk.com.hr · info@apk.com.hr" VerticalAlignment="Center"
          Foreground="#8EA3CC" FontSize="11"/>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Prekini" IsEnabled="False"
          Click="Cancel_Click" Margin="12,0,0,0"/>
        <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Generiraj licence u CSV" Click="Export_Click"
          Background="#6650D6" BorderBrush="#9B82FF"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
