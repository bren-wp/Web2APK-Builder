{
  "name": "brendigo-web2apk-builder",
  "productName": "Brendigo Web2APK Builder",
  "version": "0.1.0",
  "description": "Brendigo Web2APK Builder — Windows studio for creating Android WebView projects",
  "author": "Brendigo <https://brendigo.com>",
  "homepage": "https://brendigo.com",
  "license": "MIT",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "dist:win": "npm run icons && electron-builder --win nsis portable --x64 --publish never",
    "check": "npm run test"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.1",
    "sharp": "0.34.4",
    "png-to-ico": "3.0.2"
  },
  "build": {
    "appId": "com.brendigo.web2apk.builder",
    "productName": "Brendigo Web2APK Builder",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/brand-*.svg",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Brendigo-Web2APK-Setup.exe",
      "createDesktopShortcut": true,
      "shortcutName": "Brendigo Web2APK Builder"
    },
    "portable": {
      "artifactName": "Brendigo-Web2APK-portable.exe"
    },
    "compression": "normal"
  }
}
